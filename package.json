{
  "name": "@local/dsh-supermemory",
  "version": "0.6.1",
  "description": "Supermemory long-term memory for DeepSeek Harness: profile-scoped own memory plus read access to other agents' Supermemory containers",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "eagurin",
  "homepage": "https://github.com/eagurin/dsh-supermemory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eagurin/dsh-supermemory.git"
  },
  "bugs": {
    "url": "https://github.com/eagurin/dsh-supermemory/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "supermemory",
    "memory",
    "long-term-memory",
    "recall",
    "agent-memory"
  ],
  "engines": {
    "dsh": ">=0.2.2-0"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "docs",
    "test",
    "scripts",
    "SECURITY.md"
  ],
  "scripts": {
    "check": "node --check index.js && node scripts/check.mjs",
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
